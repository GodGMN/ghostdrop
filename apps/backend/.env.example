# Coolify backend runtime variables. PUBLIC_ORIGIN is the frontend public domain.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://drop.example.com
COOKIE_SECURE=true
DATA_DIR=/app/data
MAX_FILE_BYTES=104857600
# Cap total storage so public uploads cannot fill the disk, e.g. 53687091200 (50 GiB).
MAX_TOTAL_BYTES=
CLEANUP_INTERVAL_MS=60000

# Generate from the repository root with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Coolify puts one proxy in front of the backend. Required for real client IPs.
TRUST_PROXY=1
# Optional upload restrictions. Empty leaves uploads open to anyone.
UPLOAD_PASSWORD_HASH=
UPLOAD_ALLOWED_IPS=

# Create a private bucket with versioning never enabled before deployment.
STORAGE_BACKEND=s3
S3_ENDPOINT=https://minio.example.com
S3_BUCKET=ghostdrop-prod
S3_REGION=us-east-1
S3_PREFIX=ghostdrop/
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
