# Copy to .env next to docker-compose.yml and adjust.

# Where Ghostdrop is reachable. "http://localhost" serves plain HTTP for trying it
# out. A bare domain such as drop.example.com gets automatic HTTPS from Caddy:
# point DNS at this machine and set HTTP_PORT=80 and HTTPS_PORT=443.
GHOSTDROP_SITE=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# The exact URL people open in the browser, including any non-default port.
# Production: PUBLIC_ORIGIN=https://drop.example.com and COOKIE_SECURE=true
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

MAX_FILE_BYTES=104857600

# Generate hashes from a checkout with: npm run hash-password
# or: docker compose run --rm -it backend node apps/backend/scripts/hash-password.js
ADMIN_PASSWORD_HASH=
# Optional upload restrictions. Empty leaves uploads open to anyone.
UPLOAD_PASSWORD_HASH=
UPLOAD_ALLOWED_IPS=

# Caddy is one proxy in front of the backend. Add one per extra proxy in front of
# Caddy, and configure Caddy's trusted_proxies for it.
TRUST_PROXY=1

# Optional S3-compatible storage. See the README before enabling.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_PREFIX=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
