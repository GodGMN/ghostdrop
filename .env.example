PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
MAX_FILE_BYTES=104857600
# Set this to the public HTTPS origin in production.
PUBLIC_ORIGIN=http://localhost:3000
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
# Optional upload restrictions. Empty leaves uploads open to anyone.
# UPLOAD_PASSWORD_HASH is generated with: npm run hash-password
UPLOAD_PASSWORD_HASH=
UPLOAD_ALLOWED_IPS=
# Number of reverse proxies in front of the backend, e.g. 1. Leave empty without one.
TRUST_PROXY=
CLEANUP_INTERVAL_MS=60000

# Final file storage: local or s3. DATA_DIR remains persistent in either mode.
STORAGE_BACKEND=local
# Use the MinIO S3 API endpoint, not its console endpoint.
S3_ENDPOINT=https://minio.example.com
S3_BUCKET=ghostdrop
S3_REGION=us-east-1
S3_PREFIX=ghostdrop/
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials:
S3_SESSION_TOKEN=
