{
  "name": "ghostdrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js && npm run format:check",
    "format": "prettier --write src public scripts test package.json README.md .prettierrc.json",
    "format:check": "prettier --check src public scripts test package.json README.md .prettierrc.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "busboy": "^1.6.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
